{
  "name": "@uncli/chat",
  "version": "0.9.0-alpha",
  "description": "UNCLI's chat: the Svelte components, the <uncli-chat> and <uncli-session-list> elements, and the ChatStore they run on.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/**",
    "./src/embed/index.ts",
    "./src/lib/api/index.ts"
  ],
  "exports": {
    "./element": {
      "types": "./element.d.ts",
      "default": "./dist/uncli-chat.js"
    },
    "./embed": "./src/embed/index.ts",
    "./*": "./src/*"
  },
  "dependencies": {
    "@uncli/client": "0.9.0-alpha",
    "dompurify": "^3.4.17",
    "lucide-svelte": "^1.0.1",
    "markdown-it": "^15.0.2",
    "mermaid": "^11.17.2",
    "shiki": "^4.4.3"
  },
  "peerDependencies": {
    "svelte": "^5.57.1"
  },
  "files": [
    "src",
    "dist",
    "element.d.ts",
    "!**/*.test.ts"
  ]
}
